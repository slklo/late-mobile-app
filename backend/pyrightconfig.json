{
  "include": [
    "."
  ],
  "exclude": [
    "migrations",
    "tests/seed",
    "**/__pycache__",
    ".pytest_cache",
    "**/node_modules",
    "**/.*",
    "venv"
  ],
  "extraPaths": [
    "."
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "standard",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none",
  "reportUnnecessaryTypeIgnoreComment": "warning"
}

